#!/bin/bash
# macos: update os, applications, homebrew etc

command_exists() {
  command -v "$1" >/dev/null 2>&1
}

update_homebrew() {
  if command_exists brew; then
    echo "homebrew housekeeping..."
    brew update
    brew upgrade
    brew upgrade --cask --greedy
    brew cleanup
  else
    echo "homebrew not found. skipping."
  fi
}

update_npm() {
  if command_exists npm; then
    echo "updating npm packages globally..."
    npm update -g
  else
    echo "npm not found. skipping."
  fi
}

update_uv() {
  if command_exists uv; then
    echo "updating uv and uv tools..."
    uv self update
    uv tool upgrade --all
  fi
}

update_pipx() {
  if command_exists pipx; then
    echo "updating pipx packages..."
    pipx upgrade-all
  fi
}

update_rustup() {
  if command_exists rustup; then
    echo "updating rust toolchains..."
    rustup update
  fi
}

if [[ $(uname -s) != "Darwin" ]]; then
  echo "script is for macOS only."
  exit 1
fi

echo "updating OS..."
sudo softwareupdate -i -a

if command_exists nmap; then
  echo "updating nmap scriptdb..."
  nmap --script-updatedb
fi

if command_exists tldr; then
  echo "updating tldr pages..."
  tldr --update
fi

update_homebrew
update_npm
update_uv
update_pipx
update_rustup

if command_exists brew; then
  echo "running brew doctor..."
  brew doctor
fi

echo "completed."
