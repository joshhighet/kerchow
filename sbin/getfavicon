#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["requests", "mmh3", "beautifulsoup4", "lxml"]
# ///
# get favicon data; hash (md5 & mmh3), location, external search urls
# (shodan, censys, binaryedge, zoomeye, fofa)

import argparse
import codecs
import hashlib
import logging
from urllib.parse import urljoin

import mmh3
import requests
from bs4 import BeautifulSoup

URL_PATTERN = {
    "shodan": "https://www.shodan.io/search?query=http.favicon.hash%3A",
    "censys": "https://search.censys.io/search?resource=hosts&q=services.http.response.favicons.md5_hash%3A",
    "binaryedge": "https://app.binaryedge.io/services/query?query=web.favicon.mmh3%3A",
    "zoomeye": "https://www.zoomeye.org/searchResult?q=iconhash%3A",
    "fofa": "https://en.fofa.info/result?qbase64=",
}

log = logging.getLogger(__name__)


def get_hash(encoded_favicon, algorithm):
    if algorithm == "mmh3":
        return mmh3.hash(encoded_favicon)
    if algorithm == "md5":
        return hashlib.md5(encoded_favicon).hexdigest()
    raise ValueError(f"unknown algorithm: {algorithm}")


def get_favicon_64(domain, request_object):
    """return (base64-bytes, location-str) or (None, None)."""
    domain = domain.rstrip("/")
    try:
        soup = BeautifulSoup(request_object.text, features="lxml")
    except Exception as err:  # noqa: BLE001 - BeautifulSoup raises broadly
        log.error("error parsing html: %s", err)
        return None, None

    icon_link = soup.find("link", rel=lambda x: x and x.lower() in ("shortcut icon", "icon"))
    if icon_link is None:
        location = urljoin(domain, "/favicon.ico")
    elif icon_link["href"].startswith("data:image/"):
        inline_b64 = icon_link["href"].split(",", 1)[1].encode()
        return inline_b64, "(inline data-uri)"
    else:
        location = urljoin(domain, icon_link["href"])

    log.debug("favicon location is: %s", location)
    try:
        favicon_data = requests.get(location)
    except Exception as err:  # noqa: BLE001
        log.error("error fetching favicon: %s", err)
        return None, None
    if favicon_data.status_code != 200:
        log.info("favicon location (%s) returned status %s", location, favicon_data.status_code)
        return None, None
    return codecs.encode(favicon_data.content, "base64"), location


def print_search_url(hash_value, source):
    print(f"{source}: {URL_PATTERN[source]}{hash_value}")


def main():
    parser = argparse.ArgumentParser(description="retrieve and hash the favicon from a given domain.")
    parser.add_argument("domain", help="the domain to fetch the favicon from.")
    parser.add_argument("--debug", action="store_true", help="enable debug logging.")
    args = parser.parse_args()
    logging.basicConfig(format="%(levelname)s: %(message)s", level=logging.DEBUG if args.debug else logging.INFO)

    try:
        request_object = requests.get(args.domain)
    except Exception as err:  # noqa: BLE001
        log.error("failed to fetch the domain: %s", err)
        return
    if request_object.status_code != 200:
        log.error("failed to fetch the domain. status code: %s", request_object.status_code)
        return

    favicon_64, location = get_favicon_64(args.domain, request_object)
    if favicon_64 is None:
        log.warning("failed to retrieve the favicon.")
        return

    favicon_mmh3 = get_hash(favicon_64, "mmh3")
    favicon_md5 = get_hash(favicon_64, "md5")
    print_search_url(favicon_mmh3, "shodan")
    print_search_url(favicon_md5, "censys")
    print_search_url(favicon_mmh3, "binaryedge")
    print_search_url(favicon_mmh3, "zoomeye")
    fofa_64 = codecs.encode(f"icon_hash={favicon_mmh3}".encode(), "base64").decode()
    print_search_url(fofa_64, "fofa")
    print(f"favicon mmh3 hash: {favicon_mmh3}")
    print(f"favicon md5 hash: {favicon_md5}")
    print(f"favicon location: {location}")


if __name__ == "__main__":
    main()
