#!/bin/bash
# macos: empty trash, clear system logs & clear download history from quarantine
# https://mths.be/bum


if [[ $(uname -s) != "Darwin" ]]; then
  echo "script for macOS"
  exit 1
fi

shopt -s nullglob; for t in /Volumes/*/.Trashes; do sudo rm -rfv "$t"; done
sudo rm -rfv ~/.Trash 2>/dev/null || true
sudo rm -rfv /private/var/log/asl/*.asl 2>/dev/null || true
sqlite3 ~/Library/Preferences/com.apple.LaunchServices.QuarantineEventsV* 'delete from LSQuarantineEvent' 2>/dev/null || true
