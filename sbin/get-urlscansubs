#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["requests"]
# ///
# build datasets of active url's from urlscan

import argparse
import json
import logging
import sys

import requests

logging.basicConfig(level=logging.INFO)


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--api", help="urlscan.io key")
    args = parser.parse_args()

    if args.api is None:
        logging.warning("no api key supplied with --api, expect rate limiting")
        headers = {}
    else:
        headers = {"API-Key": args.api}

    search = requests.get("https://urlscan.io/api/v1/search/?q=*", headers=headers)
    if search.status_code != 200:
        logging.error("search failed: %s %s", search.status_code, search.reason)
        sys.exit(1)

    with open("urlscan-submissions.json", "w") as handle:
        json.dump(search.json(), handle, indent=4)
    logging.info("saved urlscan-submissions.json")

    records = []
    for entry in search.json()["results"]:
        submitted_url = entry["page"]["url"]
        logging.info("working on: %s", submitted_url)
        result = requests.get(
            "https://urlscan.io/api/v1/result/{}".format(entry["_id"]),
            headers=headers,
        )
        if result.status_code != 200:
            logging.error("result failed: %s %s", result.status_code, result.reason)
            sys.exit(1)
        records.append({
            "url": submitted_url,
            "verdict": result.json()["verdicts"]["overall"],
            "date": entry["task"]["time"],
        })
        with open("urlscan-results.json", "w") as handle:
            json.dump(records, handle, indent=4)


if __name__ == "__main__":
    main()
