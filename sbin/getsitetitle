#!/usr/bin/env python3
# return the title of a site from html on stdin

import sys
from html.parser import HTMLParser

class TitleParser(HTMLParser):
    def __init__(self):
        super().__init__()
        self._in_title = False
        self.title = None

    def handle_starttag(self, tag, attrs):
        if tag == "title" and self.title is None:
            self._in_title = True

    def handle_endtag(self, tag):
        if tag == "title":
            self._in_title = False

    def handle_data(self, data):
        if self._in_title and self.title is None:
            text = data.strip()
            if text:
                self.title = text

def main():
    if sys.stdin.isatty():
        print("getsitetitle: no input (pipe html on stdin)", file=sys.stderr)
        sys.exit(1)
    parser = TitleParser()
    parser.feed(sys.stdin.read())
    if parser.title:
        print(parser.title[:50])

if __name__ == "__main__":
    main()
