#!/usr/bin/env python3
# check if a given email address has a connected m365 account

import json
import sys
import urllib.error
import urllib.request

URL = "https://login.microsoftonline.com/common/GetCredentialType"

def credential_type(email):
    body = json.dumps({"Username": email}).encode()
    request = urllib.request.Request(URL, data=body, headers={"Content-Type": "application/json"})
    with urllib.request.urlopen(request, timeout=10) as response:
        return json.load(response)

def main():
    if len(sys.argv) != 2:
        print("usage: checkmsuser <email>", file=sys.stderr)
        sys.exit(1)
    try:
        data = credential_type(sys.argv[1])
    except (urllib.error.URLError, OSError, json.JSONDecodeError) as err:
        print(f"checkmsuser: {err}", file=sys.stderr)
        sys.exit(1)
    # IfExistsResult: 0 = account exists, 1 = account does not exist
    print(json.dumps({
        "external_idp": "FederationRedirectUrl" in data.get("Credentials", {}),
        "valid_account": data.get("IfExistsResult", 1) == 0,
    }, indent=2))

if __name__ == "__main__":
    main()
